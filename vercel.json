{
  "rewrites": [
    { "source": "/", "destination": "/public-overview.html" },
    { "source": "/manage", "destination": "/pension-simulator.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 0 * * *"
    }
  ]
}
